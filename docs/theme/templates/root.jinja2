<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>🧠</title>
    <meta name="description" content="{{ index.front.description }}">
    <link rel="stylesheet" href="/assets/style.css">
    <style>
        .hero {
            background: linear-gradient(135deg, #2c3e50 0%, #3498db 100%);
            color: white;
            padding: 4rem 0;
            text-align: center;
            margin-bottom: 3rem;
        }
        .hero h1 {
            font-size: 3rem;
            margin-bottom: 1rem;
            border: none;
            color: white;
        }
        .hero p {
            font-size: 1.3rem;
            max-width: 800px;
            margin: 0 auto;
        }
    </style>
</head>
<body>
    <header>
        <nav>
            <div class="nav-container">
                <a href="/" class="logo">🧠 Latency Recorder</a>
                <ul class="nav-menu">
                    {% for child in index.branches %}
                    <li><a href="/{{ child.name }}/">{{ child.front.title if child.front and child.front.title else child.title }}</a></li>
                    {% endfor %}
                </ul>
            </div>
        </nav>
    </header>
    
    <div class="hero">
        <div class="container">
            <h1>{{ index.front.title }}</h1>
            <p>{{ index.front.description }}</p>
        </div>
    </div>
    
    <main>
        <div class="container">
            <article>
                {{ index.content_html }}
            </article>
        </div>
    </main>
    
    <footer>
        <div class="container">
            <p>© 2025 Latency Recorder Project | <a href="https://github.com/JasperVanDenBosch/latency-recorder">GitHub</a> | <a href="https://discord.gg/47mBnvJM">Discord</a></p>
        </div>
    </footer>
</body>
</html>