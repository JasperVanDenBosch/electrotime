{% extends 'master.jinja2' %}

{% block main %}

<article id="{{ index.name }}" class="wa-stack">

    {{ index.content_html|safe }}

    {% for leaf in index.leaves|sort(attribute='front.SequenceNumber') %}
        {% include 'section.jinja2' %}
    {% endfor %}

</article>

<style>
article img {
    display: block;
    box-shadow: 5px 5px lightgray;
    border: 1px solid gray;
    width: 400px;
    margin: 1em auto;
    opacity: 80%;
}
</style>

{% endblock %}