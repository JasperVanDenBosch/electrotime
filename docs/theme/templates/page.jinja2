<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>🧠</title>
    <meta name="description" content="{{ index.front.description if index.front and index.front.description else '' }}">
    <link rel="stylesheet" href="/assets/style.css">
</head>
<body>
    <header>
        <nav>
            <div class="nav-container">
                <a href="/" class="logo">🧠 Latency Recorder</a>
                <ul class="nav-menu">
                    {% for child in root.branches %}
                    <li><a href="/{{ child.name }}/" {% if child.name == index.name or index.parent and child.name == index.parent.name %}class="active"{% endif %}>{{ child.front.title if child.front and child.front.title else child.title }}</a></li>
                    {% endfor %}
                </ul>
            </div>
        </nav>
    </header>
    
    <main>
        <div class="container">
            <article>
                {{ index.content_html }}
            </article>
            
            {% if index.branches or index.leaves %}
            <section class="sub-pages">
                <h2>📑 In This Section</h2>
                <ul>
                    {% for child in index.branches %}
                    <li><a href="/{{ index.name }}/{{ child.name }}/">{{ child.front.title if child.front and child.front.title else child.title }}</a></li>
                    {% endfor %}
                    {% for child in index.leaves %}
                    <li><a href="/{{ index.name }}/{{ child.name }}/">{{ child.front.title if child.front and child.front.title else child.title }}</a></li>
                    {% endfor %}
                </ul>
            </section>
            {% endif %}
        </div>
    </main>
    
    <footer>
        <div class="container">
            <p>© 2025 Latency Recorder Project | <a href="https://github.com/JasperVanDenBosch/latency-recorder">GitHub</a> | <a href="https://discord.gg/47mBnvJM">Discord</a></p>
        </div>
    </footer>
</body>
</html>