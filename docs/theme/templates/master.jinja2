<!DOCTYPE html>
<html lang="en" class="wa-theme-awesome">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta
        syrinx-environment="{{ index.meta.environment }}"
        syrinx-timestamp="{{ index.meta.timestamp.isoformat() }}"
        syrinx-version="{{ index.meta.syrinx_version }}"/>
    <link rel="canonical" href="{{ index.address }}">
    <link rel="sitemap" type="application/xml" href="/sitemap.xml">
    <title>{% if index.name %}{{ index.title }} · {{ root.front['SiteName'] }}{% else %}{{ root.front['MetaTitle'] }}{% endif %}</title>
    <meta name="description" content="{{ index.front.get('Description', root.front['Description']) }}">

    <!-- Open Graph / Twitter -->
    <meta property="og:type" content="website">
    <meta property="og:title" content="{% if index.name %}{{ index.title }} · {{ root.front['SiteName'] }}{% else %}{{ root.front['MetaTitle'] }}{% endif %}">
    <meta property="og:description" content="{{ index.front.get('Description', root.front['Description']) }}">
    <meta property="og:url" content="{{ index.address }}">
    <meta property="og:image" content="{{ root.front['SiteUrl'] }}{{ index.front.get('HeroImage', root.front['HeroImage']) }}">
    <meta name="twitter:card" content="summary_large_image">
    <link rel="stylesheet" href="https://ka-f.webawesome.com/webawesome@3.5.0/styles/webawesome.css" />
    <script type="module" src="https://ka-f.webawesome.com/webawesome@3.5.0/webawesome.loader.js"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/assets/css/index.css">

</head>
<body>
<wa-page>

    <header slot="header" class="site-header">
        <div class="site-header-inner">
            <a class="brand" href="/">
                <img src="/assets/electrotime.svg" alt="ElectroTime" class="site-logo">
            </a>
            <nav class="site-nav">
                <a href="/">Home</a>
                {% for branch in root.branches %}
                <a href="/{{ branch.name }}/">{{ branch.title }}</a>
                {% endfor %}
            </nav>
            {% if root.front.get('HeaderCtaLabel') %}<a class="btn btn-solid header-cta" href="{{ root.front.get('HeaderCtaHref', '#') }}">{{ root.front['HeaderCtaLabel'] }}</a>{% endif %}
            <wa-button class="nav-toggle" appearance="plain" data-drawer="open mobile-nav">
                <wa-icon name="bars" label="Menu"></wa-icon>
            </wa-button>
        </div>
    </header>

    <wa-drawer id="mobile-nav" label="Menu" placement="start" class="mobile-nav">
        <nav class="mobile-nav-links">
            <a href="/" data-drawer="close">Home</a>
            {% for branch in root.branches %}
            <a href="/{{ branch.name }}/" data-drawer="close">{{ branch.title }}</a>
            {% endfor %}
        </nav>

        {# On-page sections: embedded leaves render as <section id="{leaf.name}"> on
           the CURRENT page (index), so anchor-link them within this page. Loop
           index.leaves (not root.leaves) so the list reflects whichever page we're on;
           on a leaf-less page the {% if %} guard collapses the whole group. #}
        {% if index.leaves %}
        <p class="mobile-nav-heading">On this page</p>
        <nav class="mobile-nav-links">
            {% for leaf in index.leaves|sort(attribute='front.SequenceNumber') %}
            <a href="#{{ leaf.name }}" data-drawer="close">{{ leaf.front['Title'] }}</a>
            {% endfor %}
        </nav>
        {% endif %}

        {% if root.front.get('HeaderCtaLabel') %}
        <wa-button class="mobile-nav-cta" variant="brand" href="{{ root.front.get('HeaderCtaHref', '#') }}" data-drawer="close">{{ root.front['HeaderCtaLabel'] }}</wa-button>
        {% endif %}
    </wa-drawer>

    <main>
    {% block main %}
    {% endblock %}
    </main>

    <footer slot="footer" class="site-footer">
        <div class="site-footer-inner">
            {% if root.front.get('FooterBrand') %}<span class="footer-brand">{{ root.front['FooterBrand'] }}</span>{% endif %}
            {% if root.front.get('FooterTagline') %}<span class="footer-meta">{{ root.front['FooterTagline'] }}</span>{% endif %}
            {% if root.front.get('FooterColophonLink') %}<span class="footer-meta">{{ root.front.get('FooterColophon', '') }} <a href="{{ root.front['FooterColophonHref'] }}">{{ root.front['FooterColophonLink'] }}</a></span>{% endif %}
        </div>
    </footer>

</wa-page>

<script defer src="/assets/js/guide.js"></script>

</body>

</html>
