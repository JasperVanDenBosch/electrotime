<!DOCTYPE html>
<html lang="en" class="wa-theme-awesome">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta 
        syrinx-environment="{{ index.meta.environment }}" 
        syrinx-timestamp="{{ index.meta.timestamp.isoformat() }}" 
        syrinx-version="{{ index.meta.syrinx_version }}"/>
    <link rel="canonical" href="{{ index.address }}">
    <link rel="sitemap" type="application/xml" href="/sitemap.xml">
    <title>{{ index.title }}</title>
    <link rel="stylesheet" href="https://ka-f.webawesome.com/webawesome@3.5.0/styles/webawesome.css" />
    <script type="module" src="https://ka-f.webawesome.com/webawesome@3.5.0/webawesome.loader.js"></script>
    <link rel="stylesheet" href="/assets/css/index.css">

</head>
<body>
<wa-page>

    <header slot="header" class="wa-stack" style="align-items: center; padding: var(--wa-space-m) 0;">
        <a href="/"><img src="/assets/electrotime.svg" alt="ElectroTime" class="site-logo"></a>
        <nav class="wa-cluster">
            <a href="/">Home</a>
            {% for branch in root.branches %}
            <a href="/{{ branch.name }}/">{{ branch.title }}</a>
            {% endfor %}
        </nav>
    </header>

    <main>
    {% block main %}
    {% endblock %}
    </main>

    <footer slot="footer">
        <div class="wa-cluster">
            <span>&copy; 2026 ElectroTime team</span>
            <span>Powered by <a href="https://syrinx.site">Syrinx</a></span>
        </div>
    </footer>

</wa-page>


</body>

